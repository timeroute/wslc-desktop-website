---
import Base from '../layouts/Base.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Text from '../components/Text.astro';
import { features, links, product, screenshots } from '../data/copy';

const base = import.meta.env.BASE_URL;
const external = { target: '_blank', rel: 'noopener noreferrer' };
---

<Base>
  <SiteHeader />

  <main id="main">
    <section class="hero" aria-labelledby="product-title">
      <div class="wrap hero-grid">
        <div>
          <div class="kicker-row">
            <span class="pill">{product.version}</span>
            <span class="pill">Windows 10/11 x64</span>
            <span class="pill">{product.license}</span>
          </div>
          <h1 id="product-title">WSLc Desktop</h1>
          <p class="tagline"><Text zh="Windows 上的 WSL 容器桌面管理器。" en="A desktop manager for WSL containers on Windows." /></p>
          <div class="actions">
            <a class="btn btn-primary" href={links.msi}>
              <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                <path d="M10 3v9M6.5 8.5 10 12l3.5-3.5M4 16.5h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <Text zh="下载 MSI" en="Download MSI" />
            </a>
            <a class="btn btn-secondary" href={links.latest} {...external}>
              <Text zh="最新发布" en="Latest release" />
            </a>
            <a class="btn btn-secondary" href={links.repo} {...external}>
              <Text zh="源代码" en="Source" />
            </a>
          </div>
        </div>

        <section class="hero-list" id="features" aria-labelledby="features-title">
          <h2 id="features-title"><Text zh="功能" en="Features" /></h2>
          <ul>
            {
              features.map((feature) => (
                <li>
                  <span class="page-name">
                    <Text zh={feature.zh} en={feature.en} />
                  </span>
                  <span class="page-hint">
                    <Text zh={feature.line.zh} en={feature.line.en} />
                  </span>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </section>

    <section class="section shots" id="screenshots" aria-labelledby="screenshots-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="screenshots-title"><Text zh="界面预览" en="Screenshots" /></h2>
        </div>
        <div class="shot-grid">
          {
            screenshots.map((shot, index) => (
              <figure class:list={['shot', { 'shot-lead': index === 0 }]}>
                <div class="shot-frame">
                  <img
                    src={`${base}${shot.src}`}
                    width={shot.width}
                    height={shot.height}
                    alt={shot.alt.zh}
                    data-alt-zh={shot.alt.zh}
                    data-alt-en={shot.alt.en}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </div>
                <figcaption>
                  <p class="shot-name">
                    <span class="idx">{String(index + 1).padStart(2, '0')}</span>
                    <Text zh={shot.zh} en={shot.en} />
                  </p>
                  <p class="shot-caption">
                    <Text zh={shot.caption.zh} en={shot.caption.en} />
                  </p>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section download" id="download" aria-labelledby="download-title">
      <div class="wrap">
        <div class="panel">
          <div class="download-grid">
            <div>
              <p class="eyebrow"><Text zh="下载" en="Download" /></p>
              <h2 id="download-title"><Text zh={`下载 ${product.version}`} en={`Download ${product.version}`} /></h2>
              <p class="fine section-copy">
                <Text
                  zh="Windows 10/11 x64，WSL 2.9.3 或更高。第一次打开会安装 SDK。"
                  en="Windows 10/11 x64, WSL 2.9.3 or newer. The first launch installs the SDK."
                />
              </p>
              <code class="file">{product.msiName}</code>
              <div class="actions">
                <a class="btn btn-light" href={links.msi}>
                  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                    <path d="M10 3v9M6.5 8.5 10 12l3.5-3.5M4 16.5h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  <Text zh="下载 MSI" en="Download MSI" />
                </a>
                <a class="btn btn-ghost" href={links.latest} {...external}>
                  <Text zh="最新发布" en="Latest release" />
                </a>
                <a class="btn btn-ghost" href={links.releases} {...external}>
                  <Text zh="全部版本" en="All releases" />
                </a>
                <a class="btn btn-ghost" href={links.repo} {...external}>GitHub</a>
              </div>
            </div>
            <dl class="spec">
              <div>
                <dt><Text zh="版本" en="Version" /></dt>
                <dd>{product.version}</dd>
              </div>
              <div>
                <dt><Text zh="文件" en="File" /></dt>
                <dd>{product.msiName}</dd>
              </div>
              <div>
                <dt><Text zh="系统" en="System" /></dt>
                <dd>Windows 10/11 x64</dd>
              </div>
              <div>
                <dt><Text zh="依赖" en="Requires" /></dt>
                <dd>WSL 2.9.3+</dd>
              </div>
              <div>
                <dt><Text zh="许可" en="License" /></dt>
                <dd>
                  <a href={links.license} {...external}>{product.license}</a>
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>
