---
import '../styles/global.css';
import Text from '../components/Text.astro';
import { links, meta, product } from '../data/copy';
import type { Localized } from '../data/copy';
import { absoluteUrl, homePath, langOf, localePath, siteBase } from '../lib/locale';

interface Props {
  title?: Localized;
  description?: Localized;
}

const { title = meta.title, description = meta.description } = Astro.props;

const base = import.meta.env.BASE_URL;
const lang = langOf(Astro.url.pathname, base);
const copyKey = lang === 'en' ? 'en' : 'zh';
const htmlLang = lang === 'en' ? 'en' : 'zh-CN';
const ogLocale = lang === 'en' ? 'en_US' : 'zh_CN';
const ogLocaleAlternate = lang === 'en' ? 'zh_CN' : 'en_US';

const origin = Astro.site ?? new URL('https://timeroute.github.io');
const home = new URL(siteBase(base), origin);
const canonical = absoluteUrl(localePath(Astro.url.pathname, base, lang), origin);
const zhHref = absoluteUrl(localePath(Astro.url.pathname, base, 'zh'), origin);
const enHref = absoluteUrl(localePath(Astro.url.pathname, base, 'en'), origin);
const pageTitle = title[copyKey];
const pageDescription = description[copyKey];
const shareImage = new URL('og.png', home).href;
const logo = new URL('logo.png', home).href;
const sitemapUrl = new URL('sitemap-index.xml', home).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows 10 x64, Windows 11 x64',
  softwareVersion: product.versionNumber,
  license: links.license,
  downloadUrl: links.msi,
  codeRepository: links.repo,
  url: absoluteUrl(homePath(base, lang), origin),
  image: logo,
  inLanguage: htmlLang,
  description: pageDescription,
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={zhHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={zhHref} />
    <link rel="sitemap" href={sitemapUrl} />
    <meta name="theme-color" content="#054552" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:site_name" content={product.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}logo.png`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main"><Text zh="跳到主要内容" en="Skip to content" /></a>
    <slot />
    <script is:inline>
      (function () {
        var KEY = 'wslc-lang';
        document.querySelectorAll('[data-lang-btn]').forEach(function (link) {
          link.addEventListener('click', function () {
            try {
              var value = link.getAttribute('data-lang-btn');
              localStorage.setItem(KEY, value === 'en' ? 'en' : 'zh');
            } catch (e) {}
          });
        });
      })();
    </script>
  </body>
</html>
