---
import Base from '../layouts/Base.astro';
import Text from '../components/Text.astro';
import { features, links, nav, product, steps } from '../data/copy';

const base = import.meta.env.BASE_URL;
const external = { target: '_blank', rel: 'noopener noreferrer' };
---

<Base>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href={base}>
        <img class="logo" src={`${base}logo.png`} width="256" height="256" alt="WSLc Desktop" />
        <span>
          <span class="word">WSLc Desktop</span>
          <span class="tag"><Text zh="WSL 容器桌面" en="WSL container desktop" /></span>
        </span>
      </a>
      <nav class="nav-links" aria-label="页面 Pages">
        {
          nav.map((item) => (
            <a href={item.href}>
              <Text zh={item.zh} en={item.en} />
            </a>
          ))
        }
      </nav>
      <div class="lang" role="group" aria-label="语言 Language">
        <button type="button" data-lang-btn="zh" aria-pressed="true">中文</button>
        <button type="button" data-lang-btn="en" aria-pressed="false">EN</button>
      </div>
      <a class="btn btn-primary header-cta" href={links.msi}>
        <Text zh="下载 MSI" en="Download MSI" />
      </a>
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="product-title">
      <div class="wrap hero-grid">
        <div>
          <div class="kicker-row">
            <span class="pill">{product.version}</span>
            <span class="pill">Windows 10/11 x64</span>
            <span class="pill">{product.license}</span>
          </div>
          <h1 id="product-title">WSLc Desktop</h1>
          <p class="tagline"><Text zh="轻量级 WSL 容器桌面管理器" en="Lightweight desktop manager for WSL Containers" /></p>
          <p class="lead">
            <span class="zh" lang="zh-CN">
              面向 Windows WSL Containers（WSLc）的桌面管理器，基于 <a href={links.gpui} {...external}>GPUI Kit</a> 构建。在独立会话里管理容器、镜像与 VHD 卷。
            </span>
            <span class="en" lang="en">
              A desktop manager for Windows WSL Containers (WSLc), built with <a href={links.gpui} {...external}>GPUI Kit</a>. It manages containers, images, and VHD volumes in an isolated session.
            </span>
          </p>
          <div class="actions">
            <a class="btn btn-primary" href={links.msi}>
              <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                <path d="M10 3v9M6.5 8.5 10 12l3.5-3.5M4 16.5h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <Text zh="下载 MSI" en="Download MSI" />
            </a>
            <a class="btn btn-secondary" href={links.releases} {...external}>
              <Text zh="Releases" en="Releases" />
            </a>
            <a class="btn btn-secondary" href={links.repo} {...external}>
              <Text zh="源代码" en="Source" />
            </a>
          </div>
          <p class="fine">
            <span class="zh" lang="zh-CN">
              MSI 不捆绑 <code>wslcsdk.dll</code>。首次启动会通过阻塞对话框安装或更新 SDK。Rust 绑定使用 fork <a href={links.fork} {...external}>timeroute/wslc-rs</a>。
            </span>
            <span class="en" lang="en">
              The MSI does not bundle <code>wslcsdk.dll</code>. The first launch installs or updates the SDK through a blocking dialog. Rust bindings use the fork <a href={links.fork} {...external}>timeroute/wslc-rs</a>.
            </span>
          </p>
        </div>

        <aside class="dossier" aria-labelledby="session-title">
          <div class="dossier-bar">
            <img class="logo" src={`${base}logo.png`} width="256" height="256" alt="" />
            <div>
              <p class="dossier-name" id="session-title">{product.session}</p>
              <p class="dossier-ver">{product.version}</p>
            </div>
          </div>
          <div class="dossier-body">
            <dl class="meta-list">
              <div>
                <dt><Text zh="会话" en="Session" /></dt>
                <dd><code>{product.session}</code></dd>
              </div>
              <div>
                <dt><Text zh="目录" en="Directory" /></dt>
                <dd><code>{product.sessionRoot}</code></dd>
              </div>
            </dl>
            <p class="apart">
              <span class="zh" lang="zh-CN">与默认 <code>wslc</code> CLI 会话分离</span>
              <span class="en" lang="en">Separate from the default <code>wslc</code> CLI session</span>
            </p>
            <ol class="page-list">
              {
                features.map((feature) => (
                  <li>
                    <span class="idx">{feature.index}</span>
                    <span class="page-name">
                      <Text zh={feature.zh} en={feature.en} />
                    </span>
                    <span class="page-hint">
                      <Text zh={feature.hint.zh} en={feature.hint.en} />
                    </span>
                  </li>
                ))
              }
            </ol>
          </div>
          <p class="keep">
            <Text zh="退出应用不会终止此会话。" en="Exiting the app does not terminate this session." />
          </p>
        </aside>
      </div>

      <div class="wrap">
        <div class="facts">
          <article>
            <p class="fact-label"><Text zh="独立会话" en="Isolated session" /></p>
            <p><code>{product.session}</code></p>
          </article>
          <article>
            <p class="fact-label"><Text zh="数据目录" en="Data directory" /></p>
            <p><code>{product.sessionRoot}</code></p>
          </article>
          <article>
            <p class="fact-label"><Text zh="退出应用" en="On exit" /></p>
            <p class="plain"><Text zh="不会终止会话" en="Does not terminate the session" /></p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="features" aria-labelledby="features-title">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow"><Text zh="功能" en="Features" /></p>
          <h2 id="features-title"><Text zh="总览、容器、镜像、卷、设置" en="Overview, containers, images, volumes, settings" /></h2>
          <p>
            <Text zh="总览是默认页。" en="Overview is the default page." />
          </p>
        </div>
        <div class="feature-grid">
          {
            features.map((feature) => (
              <article class={`feat feat-${feature.id}`}>
                <span class="idx">{feature.index}</span>
                <h3>
                  <Text zh={feature.zh} en={feature.en} />
                </h3>
                <ul>
                  {feature.points.map((point) => (
                    <li>
                      <Text zh={point.zh} en={point.en} />
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="requirements" aria-labelledby="requirements-title">
      <div class="wrap req-grid">
        <div>
          <p class="eyebrow"><Text zh="环境" en="Requirements" /></p>
          <h2 id="requirements-title"><Text zh="安装前需要这些" en="What you need to install" /></h2>
          <p class="fine">
            <Text
              zh="当前发布版本为 v0.1.0。安装包从 GitHub Releases 下载，本站不托管 MSI。"
              en="The current release is v0.1.0. Installers come from GitHub Releases; this site does not host the MSI."
            />
          </p>
          <div class="stack">
            <aside class="note">
              <strong><Text zh="SDK" en="SDK" /></strong>
              <span class="zh" lang="zh-CN">MSI 不包含 <code>wslcsdk.dll</code>。第一次打开时，阻塞对话框会安装或更新 SDK。</span>
              <span class="en" lang="en">The MSI does not include <code>wslcsdk.dll</code>. The blocking dialog installs or updates the SDK the first time you open the app.</span>
            </aside>
            <aside class="note">
              <strong><Text zh="可选运行库" en="Optional runtime" /></strong>
              <span class="zh" lang="zh-CN">需要 VC++ 运行库时，安装 <a href={links.vcredist} {...external}>Visual C++ Redistributable</a>。</span>
              <span class="en" lang="en">If a VC++ runtime is required, install the <a href={links.vcredist} {...external}>Visual C++ Redistributable</a>.</span>
            </aside>
            <aside class="note">
              <strong>wslc-rs</strong>
              <span class="zh" lang="zh-CN">Rust 绑定使用 fork <a href={links.fork} {...external}>timeroute/wslc-rs</a>。</span>
              <span class="en" lang="en">Rust bindings use the fork <a href={links.fork} {...external}>timeroute/wslc-rs</a>.</span>
            </aside>
          </div>
        </div>
        <div>
          <ol class="steps">
            {
              steps.map((step, index) => (
                <li>
                  <div class="step-copy">
                    {index === 1 ? (
                      <>
                        <span class="zh" lang="zh-CN">
                          安装或更新到 <a href={links.wsl} {...external}>WSL</a> 2.9.3 或更高版本。
                        </span>
                        <span class="en" lang="en">
                          Install or update to <a href={links.wsl} {...external}>WSL</a> 2.9.3 or newer.
                        </span>
                      </>
                    ) : index === 2 ? (
                      <>
                        <span class="zh" lang="zh-CN">
                          从 <a href={links.releases} {...external}>Releases</a> 下载 MSI 并安装。
                        </span>
                        <span class="en" lang="en">
                          Download the MSI from <a href={links.releases} {...external}>Releases</a> and install it.
                        </span>
                      </>
                    ) : (
                      <Text zh={step.zh} en={step.en} />
                    )}
                  </div>
                </li>
              ))
            }
          </ol>
          <aside class="note note-follow">
            <strong><Text zh="会话" en="Session" /></strong>
            <span class="zh" lang="zh-CN">
              应用使用独立会话 <code>{product.session}</code>，目录为 <code>{product.sessionRoot}</code>，与默认 <code>wslc</code> CLI 会话分开。退出应用不会终止会话。
            </span>
            <span class="en" lang="en">
              The app uses the isolated session <code>{product.session}</code> under <code>{product.sessionRoot}</code>, separate from the default <code>wslc</code> CLI session. Exiting the app does not terminate the session.
            </span>
          </aside>
        </div>
      </div>
    </section>

    <section class="section download" id="download" aria-labelledby="download-title">
      <div class="wrap">
        <div class="panel">
          <div class="download-grid">
            <div>
              <p class="eyebrow"><Text zh="下载" en="Download" /></p>
              <h2 id="download-title"><Text zh={`获取 ${product.version}`} en={`Get ${product.version}`} /></h2>
              <p class="fine section-copy">
                <Text
                  zh="Windows 10/11 x64 安装包。文件放在 GitHub Releases，点击按钮会直接下载 MSI。"
                  en="Windows 10/11 x64 installer. The file lives on GitHub Releases; the button downloads the MSI directly."
                />
              </p>
              <code class="file">{product.msiName}</code>
              <div class="actions">
                <a class="btn btn-light" href={links.msi}>
                  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                    <path d="M10 3v9M6.5 8.5 10 12l3.5-3.5M4 16.5h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                  <Text zh="下载 MSI" en="Download MSI" />
                </a>
                <a class="btn btn-ghost" href={links.releases} {...external}>
                  <Text zh="全部版本" en="All releases" />
                </a>
                <a class="btn btn-ghost" href={links.repo} {...external}>GitHub</a>
              </div>
            </div>
            <dl class="spec">
              <div>
                <dt><Text zh="版本" en="Version" /></dt>
                <dd>{product.version}</dd>
              </div>
              <div>
                <dt><Text zh="文件" en="File" /></dt>
                <dd>{product.msiName}</dd>
              </div>
              <div>
                <dt><Text zh="系统" en="System" /></dt>
                <dd>Windows 10/11 x64</dd>
              </div>
              <div>
                <dt><Text zh="依赖" en="Requires" /></dt>
                <dd>WSL 2.9.3+</dd>
              </div>
              <div>
                <dt><Text zh="许可" en="License" /></dt>
                <dd>
                  <a href={links.license} {...external}>{product.license}</a>
                </dd>
              </div>
              <div>
                <dt><Text zh="会话" en="Session" /></dt>
                <dd>{product.session}</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">
        <img class="logo" src={`${base}logo.png`} width="256" height="256" alt="" />
        <div>
          <p class="footer-name">WSLc Desktop</p>
          <p class="footer-license">
            <a href={links.license} {...external}>{product.license}</a>
            <span> · {product.version}</span>
          </p>
        </div>
      </div>
      <nav class="footer-links" aria-label="相关链接 Links">
        <a href={links.repo} {...external}><Text zh="产品仓库" en="Product repository" /></a>
        <a href={links.releases} {...external}>Releases</a>
        <a href={links.fork} {...external}>timeroute/wslc-rs</a>
        <a href={links.gpui} {...external}>GPUI Kit</a>
        <a href={links.websiteRepo} {...external}><Text zh="网站仓库" en="Website repository" /></a>
      </nav>
    </div>
  </footer>
</Base>
